// 1. Descubrimiento de todos los contenedores en el motor Docker local
discovery.docker "contenedores_locales" {
    host = "unix:///var/run/docker.sock"
}

// 2. Pipeline de procesamiento: extrae campos, promueve labels, filtra ruido.
loki.process "extract_labels" {
    forward_to = [loki.write.remote_loki.receiver]

    // Extraer campos del JSON emitido por StructuredLogEncoder (formato logstash,
    // Spring Boot 4.x). Todos los campos MDC (traceId, userId, httpMethod, etc.)
    // se incluyen como campos de primer nivel en el JSON producido por Spring Boot.
    stage.json {
        expressions = {
            level   = "level",
            message = "message",
            logger  = "logger_name",
            traceId = "traceId",
            userId  = "userId",
        }
    }

    // Promover a stream labels (baja cardinalidad — usables en {}).
    // NUNCA promover traceId/userId — alta cardinalidad, destruye el índice de Loki.
    // container_name y container_image los añade loki.source.docker automáticamente.
    stage.labels {
        values = {
            level = "",
        }
    }

    // Red de seguridad: descartar DEBUG y TRACE antes de enviar a Loki.
    // Spring filtra por nivel, pero esta regla protege ante cambios temporales de nivel.
    stage.drop {
        expression          = "\"level\":\"(?:DEBUG|TRACE)\""
        drop_counter_reason = "debug_trace_noise"
    }
}

// 3. Fuente: captura stdout/stderr de contenedores Docker.
//    loki.source.docker desenvuelve automáticamente el formato JSON del driver de Docker
//    y entrega el contenido de "log" (JSON de Spring Boot) como la línea a procesar.
//    Requiere que el backend corra en Docker (docker-compose.yml raíz).
loki.source.docker "backend_logs" {
    host       = "unix:///var/run/docker.sock"
    targets    = discovery.docker.contenedores_locales.targets
    forward_to = [loki.process.extract_labels.receiver]
}

// 4. Envío a Loki en Coolify
loki.write "remote_loki" {
    endpoint {
        url = "https://loki.arquisoft.top/loki/api/v1/push"
    }
    // Labels estáticos que identifican el origen de esta instancia.
    // container_name y level vienen del pipeline. origin/job identifican el entorno.
    external_labels = {
        origin = "local-brayan",
        job    = "backend-java-local",
    }
}