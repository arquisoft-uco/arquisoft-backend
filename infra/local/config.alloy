// 1. Descubrimiento de todos los contenedores en el motor Docker local
discovery.docker "contenedores_locales" {
    host = "unix:///var/run/docker.sock"
}

// 2. Reglas de re-etiquetado para los targets de discovery.docker.
//    discovery.relabel es el lugar correcto para acceder a __meta_docker_* —
//    estos labels están disponibles aquí pero NO en loki.relabel (forward_to).
//    Aplica via relabel_rules en loki.source.docker (ver bloque 4).
discovery.relabel "docker_metadata" {
    targets = []

    // Promueve container_name sin la "/" inicial que antepone Docker.
    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "container"
    }

    // Captura solo el backend. Para incluir otros, cambia a "arquisoft-.*"
    rule {
        source_labels = ["container"]
        regex         = "arquisoft-backend"
        action        = "keep"
    }
}

// 3. Pipeline de procesamiento: extrae campos del JSON de Spring Boot (perfil prod),
//    promueve level a stream label y descarta ruido DEBUG/TRACE.
loki.process "extract_labels" {
    forward_to = [loki.write.remote_loki.receiver]

    // Campos del JSON emitido por StructuredLogEncoder (formato logstash, Spring Boot 4.x).
    // Todos los campos MDC (traceId, userId, httpMethod, etc.) son de primer nivel en el JSON.
    stage.json {
        expressions = {
            level   = "level",
            message = "message",
            logger  = "logger_name",
            traceId = "traceId",
            userId  = "userId",
        }
    }

    // Promueve level a stream label (baja cardinalidad — usable en {}).
    // container ya es stream label (viene de discovery.relabel vía relabel_rules).
    // NUNCA promover traceId/userId — alta cardinalidad, destruye el índice de Loki.
    stage.labels {
        values = {
            level = "",
        }
    }

    // Red de seguridad: descartar DEBUG y TRACE antes de enviar a Loki.
    stage.drop {
        expression          = "\"level\":\"(?:DEBUG|TRACE)\""
        drop_counter_reason = "debug_trace_noise"
    }
}

// 4. Fuente: captura stdout/stderr de contenedores vía Docker socket.
//    relabel_rules aplica discovery.relabel sobre los targets ANTES de iniciar
//    la lectura — aquí sí están disponibles __meta_docker_container_name y
//    el filtro keep. El label "container" resultante viaja con cada log entry.
loki.source.docker "backend_logs" {
    host          = "unix:///var/run/docker.sock"
    targets       = discovery.docker.contenedores_locales.targets
    forward_to    = [loki.process.extract_labels.receiver]
    relabel_rules = discovery.relabel.docker_metadata.rules
}

// 4. Envío a Loki en Coolify
loki.write "remote_loki" {
    endpoint {
        url = "https://loki.arquisoft.top/loki/api/v1/push"
    }
    // Labels estáticos que identifican el origen de esta instancia.
    // container_name y level vienen del pipeline. origin/job identifican el entorno.
    external_labels = {
        origin = "local-brayan",
        job    = "backend-java-local",
    }
}