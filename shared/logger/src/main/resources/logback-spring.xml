<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
    ConsoleAppender (Logback 1.5+) extiende UnsynchronizedAppenderBase y usa
    ReentrantLock — no synchronized — por lo que es seguro con Virtual Threads
    sin necesidad de AsyncAppender.
    Los niveles de log se gestionan desde application-{perfil}.yml.
    -->

    <!-- El patron de texto debe nombrar cada campo MDC: a diferencia del encoder
         estructurado, no los emite solos. Sin esto la trazabilidad solo se ve en prod. -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{origen:-—}] [%X{correlacionId:-—}] [%X{transaccionId:-—}] [%X{usuarioId:-—}] --- [%15.15t] %cyan(%-40.40logger{39}) : %m%n%throwable</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <!-- logstash: todos los campos MDC se emiten como campos JSON de primer nivel -->
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>logstash</format>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Fallback: tests sin @ActiveProfiles o arranque sin perfil definido -->
    <springProfile name="!dev &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{origen:-—}] [%X{correlacionId:-—}] [%X{transaccionId:-—}] [%X{usuarioId:-—}] --- [%15.15t] %-40.40logger{39} : %m%n%throwable</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
