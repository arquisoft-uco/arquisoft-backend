# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — ARQUISOFT BACKEND
# ==============================================================================
# Copiar y renombrar: cp .env.example .env
# El archivo .env nunca se sube al repositorio (está en .gitignore).
# ==============================================================================

# ==================== PERFIL DE SPRING ====================
# Opciones: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# CONFIGURACIÓN DE CONEXIÓN — Elegir según plataforma
# ==============================================================================

# ─── OPCIÓN 1: LINUX (--network host) ───────────────────────────────────
# En Linux, --network host comparte la red del host con el contenedor.
# localhost dentro del contenedor = localhost del host.
# Usar estos valores si ejecutás en Linux con --network host.

# DB_USUARIOS_URL=jdbc:postgresql://localhost:5432/usuarios
# DB_FICHAS_URL=jdbc:postgresql://localhost:5432/fichas_perfil
# DB_PROYECTOS_URL=jdbc:postgresql://localhost:5432/proyectos_grado
# DB_ARTEFACTOS_URL=jdbc:postgresql://localhost:5432/artefactos
# DB_REPO_ARTEFACTOS_URL=jdbc:postgresql://localhost:5432/repositorio_artefactos
# DB_ENTREGABLES_URL=jdbc:postgresql://localhost:5432/entregables
# DB_EVALUACIONES_URL=jdbc:postgresql://localhost:5432/evaluaciones
# DB_NOTIFICACIONES_URL=jdbc:postgresql://localhost:5432/notificaciones
# DB_SOLICITUDES_URL=jdbc:postgresql://localhost:5432/solicitudes
# RABBITMQ_HOST=localhost
# REDIS_HOST=localhost
# KEYCLOAK_URL=http://localhost:8081
# MINIO_ENDPOINT=http://localhost:9000

# ─── OPCIÓN 2: WINDOWS / macOS (Docker Desktop, -p 8080:8080) ──────────
# Docker Desktop corre en una VM. --network host NO funciona igual que en Linux.
# Se debe usar host.docker.internal para alcanzar servicios del host
# y mapear el puerto con -p 8080:8080. Si se despliega desde el IDE
# que este usando, se utiliza el localhost con los contenedores
# desplegados en docker desktop

DB_USUARIOS_URL=jdbc:postgresql://host.docker.internal:5432/usuarios
DB_FICHAS_URL=jdbc:postgresql://host.docker.internal:5432/fichas_perfil
DB_PROYECTOS_URL=jdbc:postgresql://host.docker.internal:5432/proyectos_grado
DB_ARTEFACTOS_URL=jdbc:postgresql://host.docker.internal:5432/artefactos
DB_REPO_ARTEFACTOS_URL=jdbc:postgresql://host.docker.internal:5432/repositorio_artefactos
DB_ENTREGABLES_URL=jdbc:postgresql://host.docker.internal:5432/entregables
DB_EVALUACIONES_URL=jdbc:postgresql://host.docker.internal:5432/evaluaciones
DB_NOTIFICACIONES_URL=jdbc:postgresql://host.docker.internal:5432/notificaciones
DB_SOLICITUDES_URL=jdbc:postgresql://host.docker.internal:5432/solicitudes
RABBITMQ_HOST=host.docker.internal
REDIS_HOST=host.docker.internal
KEYCLOAK_URL=http://host.docker.internal:8081

# ==================== CREDENCIALES DE BASE DE DATOS ====================
# Usuario común creado por init-db.sql al inicializar PostgreSQL.
DB_USUARIOS_USERNAME=arquisoft_user
DB_USUARIOS_PASSWORD=<password>

DB_FICHAS_USERNAME=arquisoft_user
DB_FICHAS_PASSWORD=<password>

DB_PROYECTOS_USERNAME=arquisoft_user
DB_PROYECTOS_PASSWORD=<password>

DB_ARTEFACTOS_USERNAME=arquisoft_user
DB_ARTEFACTOS_PASSWORD=<password>

DB_REPO_ARTEFACTOS_USERNAME=arquisoft_user
DB_REPO_ARTEFACTOS_PASSWORD=<password>

DB_ENTREGABLES_USERNAME=arquisoft_user
DB_ENTREGABLES_PASSWORD=<password>

DB_EVALUACIONES_USERNAME=arquisoft_user
DB_EVALUACIONES_PASSWORD=<password>

DB_NOTIFICACIONES_USERNAME=arquisoft_user
DB_NOTIFICACIONES_PASSWORD=<password>

DB_SOLICITUDES_USERNAME=arquisoft_user
DB_SOLICITUDES_PASSWORD=<password>

# ==================== RABBITMQ ====================
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ==================== REDIS ====================
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=default123

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE=5
# RATE_LIMIT_MAX_TRACKED_IPS eliminado — propiedad removida al migrar a RedisBucketResolver

# ==================== CORS ====================
# En prod agregar el dominio del frontend y del backend (para Swagger)
CORS_ALLOWED_ORIGINS=https://<tu-backend-host>,https://<tu-frontend-host>

# ==================== KEYCLOAK ====================
KEYCLOAK_REALM=arquisoft
KEYCLOAK_CLIENT_ID=arquisoft-api
KEYCLOAK_CLIENT_SECRET=<client-secret>

# ==================== MINIO (Object Storage) ====================
# Servidor MinIO — usar host.docker.internal en Windows/macOS, localhost en Linux
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=arquisoft-backend
MINIO_SECRET_KEY=<contraseña-del-usuario-arquisoft-backend>
# Tiempo de expiración de presigned URLs (minutos). Defaults: 15 upload, 15 download.
MINIO_UPLOAD_EXPIRY_MINUTES=15
MINIO_DOWNLOAD_EXPIRY_MINUTES=15
# true solo si MinIO usa certificado autofirmado (dev/staging). En prod usar cert de CA válida.
MINIO_TRUST_SELF_SIGNED_CERTS=false

# ==================== NOTIFICACIONES (envío de correos) ====================
# Proveedor activo: 'log' (registra y NO entrega — default seguro) o 'smtp'.
NOTIFICACION_PROVEEDOR=log
NOTIFICACION_REMITENTE_EMAIL=no-reply@arquisoft.local
NOTIFICACION_REMITENTE_NOMBRE=Arquisoft
NOTIFICACION_PLANTILLA=plantilla.correo-base
NOTIFICACION_PLANTILLA_REFRESCO=true
NOTIFICACION_PLANTILLA_REFRESCO_INTERVALO=PT5M
# Reintento de envios fallidos (job programado, no el consumidor).
NOTIFICACION_REINTENTO_MAX_INTENTOS=5
NOTIFICACION_REINTENTO_LIMITE=50
NOTIFICACION_REINTENTO_INTERVALO=PT5M

# ==================== SMTP ====================
# Local (docker-compose up mailpit): host.docker.internal:1025, sin auth. Bandeja en :8025.
# Brevo (300 correos/día gratis): smtp-relay.brevo.com:587, auth y STARTTLS en true.
#   MAIL_USERNAME es el login SMTP de Brevo, MAIL_PASSWORD la SMTP key (no la de la cuenta).
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ==================== OBSERVABILIDAD / NIVELES DE LOG ====================
# Cada variable controla un GRUPO de loggers, no un paquete suelto. Los grupos se
# declaran en application.yml (logging.group) porque por variable de entorno el binding
# relajado de Spring Boot solo llega a nivel de paquete, nunca de clase.
#
#   LOG_NIVEL_ROOT        todo lo no cubierto por los demas grupos
#   LOG_NIVEL_NEGOCIO     com.arquisoft.{fichas,seguridad,usuarios,notificaciones,evaluaciones}
#   LOG_NIVEL_PLATAFORMA  com.arquisoft.shared
#   LOG_NIVEL_DATOS       SQL de Hibernate + parametros ligados
#   LOG_NIVEL_SEGURIDAD   Spring Security (cadena de filtros, decisiones de acceso)
#   LOG_NIVEL_MENSAJERIA  AMQP, RabbitMQ y Spring Modulith (outbox y reintentos)
#   LOG_NIVEL_FRAMEWORK   Spring Web/Data, Hibernate, Hikari, Flyway, Tomcat, Micrometer
#
# Niveles validos: TRACE | DEBUG | INFO | WARN | ERROR | OFF
#
# Si NO defines ninguna, cada perfil trae sus propios defaults (los de DESARROLLO para
# dev, los de PRODUCCION para prod): no hace falta copiar nada para el uso normal.
# Definelas solo para desviarte del perfil, y recuerda que estas variables NO llegan a
# `./gradlew test` — un slice test corre con el classpath de test, no con este archivo.

# ─── DESARROLLO (default del perfil dev) ─────────────────────────────────
# Todo el codigo propio en DEBUG y el SQL visible. El framework en INFO para que el
# ruido de arranque no tape los logs de negocio.
LOG_NIVEL_ROOT=INFO
LOG_NIVEL_NEGOCIO=DEBUG
LOG_NIVEL_PLATAFORMA=DEBUG
LOG_NIVEL_DATOS=DEBUG
LOG_NIVEL_SEGURIDAD=DEBUG
LOG_NIVEL_MENSAJERIA=DEBUG
LOG_NIVEL_FRAMEWORK=INFO

# ─── DEPURANDO UN BUG CONCRETO ───────────────────────────────────────────
# Perfil dev pero en silencio salvo lo que estas mirando. Sube a DEBUG solo el grupo
# implicado y baja el resto: el DEBUG de verificacion previa de cada use case lleva los
# booleanos sobre los que deciden las Rule, que es lo que explica un 422.
# LOG_NIVEL_ROOT=WARN
# LOG_NIVEL_NEGOCIO=DEBUG
# LOG_NIVEL_PLATAFORMA=WARN
# LOG_NIVEL_DATOS=OFF
# LOG_NIVEL_SEGURIDAD=WARN
# LOG_NIVEL_MENSAJERIA=WARN
# LOG_NIVEL_FRAMEWORK=WARN

# ─── PRUEBAS / QA ────────────────────────────────────────────────────────
# Para un despliegue de QA con SPRING_PROFILES_ACTIVE=prod (JSON estructurado, como
# produccion) pero con mas detalle del que se deja en produccion: negocio en DEBUG para
# poder reproducir incidencias, SQL apagado para no inundar el agregador de logs.
# LOG_NIVEL_ROOT=WARN
# LOG_NIVEL_NEGOCIO=DEBUG
# LOG_NIVEL_PLATAFORMA=DEBUG
# LOG_NIVEL_DATOS=OFF
# LOG_NIVEL_SEGURIDAD=INFO
# LOG_NIVEL_MENSAJERIA=INFO
# LOG_NIVEL_FRAMEWORK=WARN

# ─── PRODUCCION (default del perfil prod) ────────────────────────────────
# Solo eventos de negocio y errores. El resto en WARN y el SQL apagado: en Loki lo que
# sirve para depurar es el traceId, no la sentencia.
# LOG_NIVEL_ROOT=WARN
# LOG_NIVEL_NEGOCIO=INFO
# LOG_NIVEL_PLATAFORMA=INFO
# LOG_NIVEL_DATOS=OFF
# LOG_NIVEL_SEGURIDAD=WARN
# LOG_NIVEL_MENSAJERIA=WARN
# LOG_NIVEL_FRAMEWORK=WARN

# ==================== JVM ====================
# Porcentajes sobre el Memory Limit del contenedor Docker (configurado en Coolify → Resource Limits)
# En prod con 700MB de límite: heap máximo ≈ 490MB, heap inicial ≈ 280MB
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=40.0
