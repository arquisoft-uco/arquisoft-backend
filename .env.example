# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — ARQUISOFT BACKEND
# ==============================================================================
# Copiar y renombrar: cp .env.example .env
# El archivo .env nunca se sube al repositorio (está en .gitignore).
# ==============================================================================

# ==================== PERFIL DE SPRING ====================
# Opciones: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# CONFIGURACIÓN DE CONEXIÓN — Elegir según plataforma
# ==============================================================================

# ─── OPCIÓN 1: LINUX (--network host) ───────────────────────────────────
# En Linux, --network host comparte la red del host con el contenedor.
# localhost dentro del contenedor = localhost del host.
# Usar estos valores si ejecutás en Linux con --network host.

# DB_SEGURIDAD_URL=jdbc:postgresql://localhost:5432/usuarios
# DB_FICHAS_URL=jdbc:postgresql://localhost:5432/fichas_perfil
# DB_PROYECTOS_URL=jdbc:postgresql://localhost:5432/proyectos_grado
# DB_ARTEFACTOS_URL=jdbc:postgresql://localhost:5432/artefactos
# DB_REPO_ARTEFACTOS_URL=jdbc:postgresql://localhost:5432/repositorio_artefactos
# DB_ENTREGABLES_URL=jdbc:postgresql://localhost:5432/entregables
# DB_EVALUACIONES_URL=jdbc:postgresql://localhost:5432/evaluaciones
# RABBITMQ_HOST=localhost
# REDIS_HOST=localhost
# KEYCLOAK_URL=http://localhost:8081

# ─── OPCIÓN 2: WINDOWS / macOS (Docker Desktop, -p 8080:8080) ──────────
# Docker Desktop corre en una VM. --network host NO funciona igual que en Linux.
# Se debe usar host.docker.internal para alcanzar servicios del host
# y mapear el puerto con -p 8080:8080.

DB_SEGURIDAD_URL=jdbc:postgresql://host.docker.internal:5432/usuarios
DB_FICHAS_URL=jdbc:postgresql://host.docker.internal:5432/fichas_perfil
DB_PROYECTOS_URL=jdbc:postgresql://host.docker.internal:5432/proyectos_grado
DB_ARTEFACTOS_URL=jdbc:postgresql://host.docker.internal:5432/artefactos
DB_REPO_ARTEFACTOS_URL=jdbc:postgresql://host.docker.internal:5432/repositorio_artefactos
DB_ENTREGABLES_URL=jdbc:postgresql://host.docker.internal:5432/entregables
DB_EVALUACIONES_URL=jdbc:postgresql://host.docker.internal:5432/evaluaciones
RABBITMQ_HOST=host.docker.internal
REDIS_HOST=host.docker.internal
KEYCLOAK_URL=http://host.docker.internal:8081

# ==================== CREDENCIALES DE BASE DE DATOS ====================
# Usuario común creado por init-db.sql al inicializar PostgreSQL.
DB_SEGURIDAD_USERNAME=arquisoft_user
DB_SEGURIDAD_PASSWORD=<password>

DB_FICHAS_USERNAME=arquisoft_user
DB_FICHAS_PASSWORD=<password>

DB_PROYECTOS_USERNAME=arquisoft_user
DB_PROYECTOS_PASSWORD=<password>

DB_ARTEFACTOS_USERNAME=arquisoft_user
DB_ARTEFACTOS_PASSWORD=<password>

DB_REPO_ARTEFACTOS_USERNAME=arquisoft_user
DB_REPO_ARTEFACTOS_PASSWORD=<password>

DB_ENTREGABLES_USERNAME=arquisoft_user
DB_ENTREGABLES_PASSWORD=<password>

DB_EVALUACIONES_USERNAME=arquisoft_user
DB_EVALUACIONES_PASSWORD=<password>

# ==================== RABBITMQ ====================
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ==================== REDIS ====================
REDIS_PORT=6379

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE=5
RATE_LIMIT_MAX_TRACKED_IPS=1000

# ==================== CORS ====================
# En prod agregar el dominio del frontend y del backend (para Swagger)
CORS_ALLOWED_ORIGINS=https://<tu-backend-host>,https://<tu-frontend-host>

# ==================== KEYCLOAK ====================
KEYCLOAK_REALM=arquisoft
KEYCLOAK_CLIENT_ID=arquisoft-api
KEYCLOAK_CLIENT_SECRET=<client-secret>

# ==================== JVM ====================
# Porcentajes sobre el Memory Limit del contenedor Docker (configurado en Coolify → Resource Limits)
# En prod con 700MB de límite: heap máximo ≈ 490MB, heap inicial ≈ 280MB
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=40.0
