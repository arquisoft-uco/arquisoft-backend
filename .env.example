SPRING_PROFILES_ACTIVE=dev
spring.profiles.active=dev

# ==================== DATASOURCES ====================
# Reemplaza <host> con la IP o hostname del servidor PostgreSQL
DB_SEGURIDAD_URL=jdbc:postgresql://<host>:5432/usuarios
DB_SEGURIDAD_USERNAME=arquisoft_user
DB_SEGURIDAD_PASSWORD=<password>

DB_FICHAS_URL=jdbc:postgresql://<host>:5432/fichas_perfil
DB_FICHAS_USERNAME=arquisoft_user
DB_FICHAS_PASSWORD=<password>

DB_PROYECTOS_URL=jdbc:postgresql://<host>:5432/proyectos_grado
DB_PROYECTOS_USERNAME=arquisoft_user
DB_PROYECTOS_PASSWORD=<password>

DB_ARTEFACTOS_URL=jdbc:postgresql://<host>:5432/artefactos
DB_ARTEFACTOS_USERNAME=arquisoft_user
DB_ARTEFACTOS_PASSWORD=<password>

DB_REPO_ARTEFACTOS_URL=jdbc:postgresql://<host>:5432/repositorio_artefactos
DB_REPO_ARTEFACTOS_USERNAME=arquisoft_user
DB_REPO_ARTEFACTOS_PASSWORD=<password>

DB_ENTREGABLES_URL=jdbc:postgresql://<host>:5432/entregables
DB_ENTREGABLES_USERNAME=arquisoft_user
DB_ENTREGABLES_PASSWORD=<password>

DB_EVALUACIONES_URL=jdbc:postgresql://<host>:5432/evaluaciones
DB_EVALUACIONES_USERNAME=arquisoft_user
DB_EVALUACIONES_PASSWORD=<password>

# ==================== RABBITMQ ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE=5

# ==================== CORS ====================
# En prod agregar el dominio del frontend y del backend (para Swagger)
CORS_ALLOWED_ORIGINS=https://<tu-backend-host>,https://<tu-frontend-host>

# ==================== KEYCLOAK ====================
KEYCLOAK_URL=https://<keycloak-host>/auth
KEYCLOAK_REALM=arquisoft
KEYCLOAK_CLIENT_ID=arquisoft-api
KEYCLOAK_CLIENT_SECRET=<client-secret>
