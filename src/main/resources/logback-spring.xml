<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
    ==========================================================================
    logback-spring.xml — Arquisoft Backend
    ==========================================================================
    Procesado por Spring Boot (nombre "-spring.xml" habilita <springProfile>).

    Estándar unificado (dev y prod):
      CONSOLA → texto legible con colores ANSI  (para el desarrollador)
      ARCHIVO → JSON estructurado               (para Alloy → Loki)

    La diferencia entre perfiles es SOLO comportamental, no estructural:
      dev  → discardingThreshold=0  (nunca descarta), retención 7 días
      prod → discardingThreshold=20 (descarta INFO bajo presión), retención 30 días
    Los niveles de log se controlan desde application-{perfil}.yml.

    Thread safety con Virtual Threads (Java 21):
      AsyncAppender desacopla el hilo productor (VT) del I/O del appender.
      Sin él, synchronized en ConsoleAppender/FileAppender causa "pinning" del VT
      a su carrier thread bajo alta concurrencia, degradando el throughput.

    Trace IDs:
      micrometer-tracing-bridge-brave inyecta traceId + spanId en MDC
      automáticamente por request. LogstashEncoder los incluye en el JSON.
    ==========================================================================
    -->

    <!-- Captura el perfil activo para usarlo como campo customFields del JSON -->
    <springProperty name="activeProfile" source="spring.profiles.active" defaultValue="dev"/>

    <!-- ==================================================================
         APPENDER: CONSOLE — texto legible con colores ANSI
         Definido globalmente: es idéntico en dev y prod.
         En servidores sin TTY los colores ANSI se ignoran automáticamente.
         ================================================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) --- [%15.15t] %cyan(%-40.40logger{39}) : %m%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================================================================
         PERFIL: dev
         - JSON_FILE: retención 7 días, totalSizeCap 500MB
         - AsyncAppender: discardingThreshold=0 (nunca descarta — ver todos los logs)
         - Root: INFO (ajustado por paquete desde application-dev.yml)
         ================================================================== -->
    <springProfile name="dev">
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/arquisoft.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/archived/arquisoft.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"arquisoft-backend","env":"${activeProfile}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
            </encoder>
        </appender>
        <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>2048</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="CONSOLE"/>
        </appender>
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>2048</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="JSON_FILE"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- ==================================================================
         PERFIL: prod
         - JSON_FILE: retención 30 días, totalSizeCap 2GB
         - AsyncAppender: discardingThreshold=20 (descarta INFO/DEBUG bajo presión
           de cola; WARN y ERROR nunca se descartan — throughput > completitud)
         - Root: WARN (com.arquisoft elevado a INFO desde application-prod.yml)
         ================================================================== -->
    <springProfile name="prod">
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/arquisoft.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/archived/arquisoft.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"arquisoft-backend","env":"${activeProfile}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
            </encoder>
        </appender>
        <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>4096</queueSize>
            <discardingThreshold>20</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="CONSOLE"/>
        </appender>
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>4096</queueSize>
            <discardingThreshold>20</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="JSON_FILE"/>
        </appender>
        <root level="WARN">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

</configuration>
