                <mxCell id="n6" value="6) XxxQueryPortImpl (application)&#xa;Implementa XxxQueryPort. Delega a&#xa;XxxReadRepositoryPort (DIP).&#xa;Sin logica de negocio, sin validaciones." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;size=14;" parent="1" vertex="1">
