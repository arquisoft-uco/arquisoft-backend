<mxCell id="t3_title" value="Mapa de Contextos del Sistema (Arquisoft Backend)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="1600" height="40" as="geometry"/></mxCell>
<mxCell id="t3_sub" value="Vista de contenedores: los 9 bounded contexts, el shared kernel y la infraestructura externa. Los contextos NUNCA se importan entre si: solo se integran via eventos de dominio en RabbitMQ. El detalle de componentes por capa (Interactor, UseCase, Rule, OutputPort...) esta en la pestana 2." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="1600" height="44" as="geometry"/></mxCell>
<mxCell id="seguridad_title" value="«Bounded Context» Seguridad&#xa;sin BD propia — Keycloak + Redis" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="460" height="34" as="geometry"/></mxCell>
