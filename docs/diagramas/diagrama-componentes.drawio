<mxCell id="flow_legend" value="Cada flecha discontinua con triangulo hueco = &quot;implementa&quot;.&#xa;La dependencia de codigo siempre cruza hacia la interfaz&#xa;de la capa mas interna; el detalle concreto vive afuera." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="580" width="640" height="90" as="geometry"/></mxCell>
