<mxCell id="t1_title" value="Clean Architecture — Regla de Dependencia (Robert C. Martin)&#xa;aplicada a Arquisoft Backend" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="50" as="geometry"/></mxCell>
<mxCell id="t1_sub" value="Representada con cuadrados concentricos (equivalente a los anillos del libro) para maxima legibilidad: cada capa solo conoce las de mas adentro. Las flechas de codigo fuente siempre apuntan hacia el centro." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1500" height="40" as="geometry"/></mxCell>
<mxCell id="ring4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="1400" height="1400" as="geometry"/></mxCell>
<mxCell id="ring3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="320" width="1040" height="1040" as="geometry"/></mxCell>
<mxCell id="ring2" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="680" height="680" as="geometry"/></mxCell>
<mxCell id="ring1" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="680" width="320" height="320" as="geometry"/></mxCell>
<mxCell id="lbl4" value="FRAMEWORKS &amp; DRIVERS  (Infraestructura Externa)&#xa;Spring Boot 4 · PostgreSQL 18 (7 esquemas) · RabbitMQ 4.2 · Redis 7 · Keycloak 26.6 · MinIO · Flyway" style="text;html=1;align=center;verticalAlign=top;fontStyle=1;fontSize=13;whiteSpace=wrap;fillColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="1360" height="130" as="geometry"/></mxCell>
<mxCell id="lbl3" value="INTERFACE ADAPTERS&#xa;{Accion}{Feature}Controlador · RequestDTO · RequestMapper (toCommand) · {Evento}InputAdapter (AMQP)&#xa;{Feature}Command/QueryOutputAdapter · {Feature}Entity/Repository/Mapper · GlobalAppExceptionHandler" style="text;html=1;align=center;verticalAlign=top;fontStyle=1;fontSize=13;whiteSpace=wrap;fillColor=none;" vertex="1" parent="1"><mxGeometry x="320" y="360" width="960" height="130" as="geometry"/></mxCell>
<mxCell id="lbl2" value="APPLICATION BUSINESS RULES  (Use Cases)&#xa;{Accion}{Feature}Interactor (@Transactional, construye el Domain y orquesta UseCases)&#xa;{Accion}{Feature}UseCaseImpl · {Feature}Validator · {Feature}Finder · Command/Criteria/ReadModel" style="text;html=1;align=center;verticalAlign=top;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=none;" vertex="1" parent="1"><mxGeometry x="500" y="540" width="600" height="130" as="geometry"/></mxCell>
<mxCell id="lbl1" value="ENTERPRISE&#xa;BUSINESS RULES&#xa;(Entities)&#xa;&#xa;{Feature}Domain&#xa;{Concepto}Rule · OutputPort&#xa;sin Spring · sin Lombok&#xa;crear(...) / reconstruir(...)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=none;" vertex="1" parent="1"><mxGeometry x="655" y="690" width="290" height="300" as="geometry"/></mxCell>
<mxCell id="dep_arrow_note" value="El codigo fuente solo puede&#xa;apuntar hacia adentro.&#xa;Nada de adentro sabe&#xa;nada de afuera (DIP)." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1060" y="1260" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="flow_title" value="Cruce de fronteras dentro de un feature (DIP)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1580" y="140" width="640" height="30" as="geometry"/></mxCell>
