<mxCell id="t2_title" value="Diagrama de Componentes UML — Hexagonal + CQRS (Arquisoft Backend)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="40" as="geometry"/></mxCell>
<mxCell id="t2_sub" value="Notacion UML Component (shape=component), agrupados por capa. Plantilla generica por feature ({Feature}, {Accion}, {Consulta}, {Concepto}), calcada del flujo real mas completo del repo (fichas/fichaperfil). COMMAND (arriba) y QUERY (abajo) son cadenas de dependencia separadas — solo comparten la capa de Persistencia." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1700" height="40" as="geometry"/></mxCell>
