        <mxCell id="e130" value="Page&amp;lt;{Entidad}JpaQueryEntity&amp;gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2209" y="3382" as="sourcePoint"/><mxPoint x="1525" y="3382" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e131" value="15: toReadModel(jpaQueryEntity)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1525" y="3419" as="sourcePoint"/><mxPoint x="2441" y="3419" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e132" value="{Entidad}ReadModel" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2441" y="3456" as="sourcePoint"/><mxPoint x="1525" y="3456" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e133" value="17: toResult(page)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1525" y="3493" as="sourcePoint"/><mxPoint x="1745" y="3493" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e134" value="PaginatedResult&amp;lt;{Entidad}ReadModel&amp;gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="3530" as="sourcePoint"/><mxPoint x="1525" y="3530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e135" value="PaginatedResult&amp;lt;{Entidad}ReadModel&amp;gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1513" y="3567" as="sourcePoint"/><mxPoint x="1293" y="3567" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e136" value="PaginatedResult&amp;lt;{Entidad}ReadModel&amp;gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1281" y="3604" as="sourcePoint"/><mxPoint x="365" y="3604" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e137" value="21: toResponse(readModel)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="3641" as="sourcePoint"/><mxPoint x="817" y="3641" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e138" value="{Entidad}ResponseDTO" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="817" y="3678" as="sourcePoint"/><mxPoint x="365" y="3678" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e139" value="HTTP 200 + PageResponseDTO&amp;lt;{Entidad}ResponseDTO&amp;gt;&lt;br&gt;(PageResponseDTO.from, shared:web)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="353" y="3730" as="sourcePoint"/><mxPoint x="133" y="3730" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v140" value="Controller de lectura propio, separado del de escritura aunque compartan @RequestMapping. Recibe QueryCriteriaRequestDTO y devuelve PageResponseDTO&amp;lt;{Entidad}ResponseDTO&amp;gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="256" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v141" value="Contraparte de lectura del RequestMapper de comando: DTO generico de shared:query &amp;#8594; Criteria tipado del feature. Estatico, sin @Component." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="488" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v142" value="El &lt;b&gt;ReadModel nunca se serializa&lt;/b&gt;: no lleva Jackson ni Lombok. Este mapper lo convierte en {Entidad}ResponseDTO, donde vive la politica de serializacion (@JsonInclude, nombres de campo)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v143" value="Extiende QueryCriteria y declara camposOrdenables() / camposFiltrables(). &lt;b&gt;Un ordenamiento o filtro invalido se rechaza aqui, antes de tocar SQL&lt;/b&gt; &amp;#8212; FiltroException es ApplicationException (400), no DomainException." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="952" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v144" value="&lt;b&gt;Sin Interactor&lt;/b&gt;: no hay unidad de trabajo que delimitar, asi que @Transactional(readOnly = true) va en el propio UseCase, y el qualifier del transactionManager es obligatorio (usuariosTransactionManager es @Primary). Sin logica de negocio y sin agregado." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1184" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v145" value="&lt;b&gt;Pura delegacion&lt;/b&gt;: no arma PageRequest ni Sort a mano. No captura excepciones de Spring Data para remapearlas a 4xx &amp;#8212; un PropertyReferenceException aqui solo puede ser un defecto del SortMapper, y debe salir como 500." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1416" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v146" value="shared:jpa aporta las dos piezas simetricas: toPageable(criteria, traductor) a la entrada y toResult(page) a la salida. El feature solo pone la referencia a metodo {Entidad}SortMapper::traducir." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1648" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v147" value="Traduce el NodoFiltro del Criteria a Specification via CampoSpec / QueryJpaSpecification (shared:jpa). Un campo de filtro desconocido se rechaza aqui." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1880" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v148" value="Extiende QueryRepository / SpecificationQueryRepository (@NoRepositoryBean sobre Repository): expone findById/existsById/findAll/count y &lt;b&gt;nunca hereda save ni delete&lt;/b&gt; &amp;#8212; el compilador mantiene honesto el CQRS." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2112" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v149" value="{Entidad}JpaQueryEntity es @Subselect + @Immutable + @Synchronize: la consulta con sus joins viaja en el Java, asi que la entidad es &lt;b&gt;plana&lt;/b&gt; (asesorNombre, no asesorFicha.nombre). &lt;b&gt;El lado query jamas importa el JpaEntity de command.&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2344" y="3786" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v150" value="BLOQUE 3 &amp;#8212; EVENTO (integracion entre bounded contexts por AMQP)&lt;br&gt;&lt;font style=&#x27;font-size:11px;font-weight:normal&#x27;&gt;Continuacion del bloque 1: tras el commit, Spring Modulith externaliza la fila de event_publication al exchange de RabbitMQ y el contexto consumidor la recibe aqui&lt;br&gt;el evento viaja &lt;b&gt;completo&lt;/b&gt; (el evento de asesor lleva nombre y correo) para que el consumidor no tenga que volver a consultar al productor&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="3997" width="1598" height="71" as="geometry"/></mxCell>
        <mxCell id="v151" value="&lt;b&gt;:RabbitMQ&lt;/b&gt;&lt;br&gt;&amp;#171;exchange + routing key = temaEvento&amp;#187;&lt;br&gt;&lt;i&gt;RabbitMQConfig.EXCHANGE_NAME&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="24" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v152" value="&lt;b&gt;:{Evento}Consumer&lt;/b&gt;&lt;br&gt;&amp;#171;extiende AbstractEventConsumer &amp;#183; primaryadapter/amqp&amp;#187;&lt;br&gt;&lt;i&gt;ej. AsesorFichaCambiadoConsumer&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="256" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v153" value="&lt;b&gt;:GestorTraza&lt;/b&gt;&lt;br&gt;&amp;#171;shared:tracing &amp;#183; application/traza/primaryport&amp;#187;&lt;br&gt;&lt;i&gt;AlcanceTraza (AutoCloseable)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v154" value="&lt;b&gt;:{Evento}Payload&lt;/b&gt;&lt;br&gt;&amp;#171;record &amp;#183; primaryadapter/amqp&amp;#187;&lt;br&gt;&lt;i&gt;ej. AsesorFichaCambiadoPayload&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="720" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v155" value="&lt;b&gt;:{Accion}{Entidad}InteractorImpl&lt;/b&gt;&lt;br&gt;&amp;#171;@Transactional &amp;#183; otro bounded context&amp;#187;&lt;br&gt;&lt;i&gt;ej. EnviarNotificacionInteractorImpl&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="952" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v156" value="&lt;b&gt;:{Accion}{Entidad}UseCaseImpl&lt;/b&gt;&lt;br&gt;&amp;#171;@Component &amp;#183; command/usecase/impl&amp;#187;&lt;br&gt;&lt;i&gt;ej. EnviarNotificacionUseCaseImpl&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="1184" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v157" value="&lt;b&gt;:Channel&lt;/b&gt;&lt;br&gt;&amp;#171;com.rabbitmq.client &amp;#183; ACK manual&amp;#187;&lt;br&gt;&lt;i&gt;prefetch = 1&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;size=104;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="1416" y="4086" width="206" height="635" as="geometry"/></mxCell>
        <mxCell id="v158" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="121" y="4260" width="12" height="16" as="geometry"/></mxCell>
        <mxCell id="v159" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="353" y="4260" width="12" height="439" as="geometry"/></mxCell>
        <mxCell id="v160" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="585" y="4312" width="12" height="83" as="geometry"/></mxCell>
        <mxCell id="v161" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="817" y="4416" width="12" height="53" as="geometry"/></mxCell>
        <mxCell id="v162" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1049" y="4505" width="12" height="142" as="geometry"/></mxCell>
        <mxCell id="v163" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1281" y="4557" width="12" height="53" as="geometry"/></mxCell>
        <mxCell id="v164" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1513" y="4683" width="12" height="16" as="geometry"/></mxCell>
        <mxCell id="e165" value="1: @RabbitListener(queues = ...)&lt;br&gt;Message + Channel" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="133" y="4268" as="sourcePoint"/><mxPoint x="353" y="4268" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e166" value="2: abrir(SolicitudTraza.paraEvento(&lt;br&gt;header AMQP_TRACE_ID))" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="4320" as="sourcePoint"/><mxPoint x="585" y="4320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e167" value="AlcanceTraza (try-with-resources)&lt;br&gt;correlacionId heredado,&lt;br&gt;transaccionId nuevo" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="4387" as="sourcePoint"/><mxPoint x="365" y="4387" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e168" value="4: deserialize(message, {Evento}Payload.class)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="4424" as="sourcePoint"/><mxPoint x="817" y="4424" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e169" value="{Evento}Payload" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="817" y="4461" as="sourcePoint"/><mxPoint x="365" y="4461" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e170" value="6: ejecutar(new {Accion}{Entidad}Command(...))&lt;br&gt;el consumer traduce evento &amp;#8594; comando" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontStyle=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="4513" as="sourcePoint"/><mxPoint x="1049" y="4513" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e171" value="7: ejecutar(dominio)&lt;br&gt;dentro de @Transactional" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1061" y="4565" as="sourcePoint"/><mxPoint x="1281" y="4565" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e172" value="void / UUID" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1281" y="4602" as="sourcePoint"/><mxPoint x="1061" y="4602" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e173" value="void / UUID" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1049" y="4639" as="sourcePoint"/><mxPoint x="365" y="4639" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e174" value="10: basicAck(deliveryTag, false)&lt;br&gt;si algo lanzo: basicNack(...) &amp;#8594; DLQ" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontStyle=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="4691" as="sourcePoint"/><mxPoint x="1513" y="4691" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v175" value="Los contextos &lt;b&gt;nunca se importan entre si&lt;/b&gt;: se comunican solo por eventos de dominio sobre RabbitMQ. Publisher confirms, ACK manual, prefetch = 1." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="24" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v176" value="Sufijo &lt;b&gt;Consumer&lt;/b&gt;, no Controller &amp;#8212; Controller queda reservado para HTTP. Aqui se decide que notificacion corresponde a que evento: agregar un evento es agregar un consumer, sin tocar application ni domain." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="256" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v177" value="AbstractEventConsumer abre el alcance de traza antes de manejar el mensaje. close() restaura el MDC previo, no lo borra, para que un consumo anidado devuelva el valor externo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="488" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v178" value="El payload es un record propio del adapter, no la clase del evento del contexto productor: importar esa clase reintroduciria el acoplamiento que los eventos existen para eliminar." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v179" value="El consumer inyecta el &lt;b&gt;Interactor&lt;/b&gt;, igual que un controller, y por eso el consumo hereda la transaccion del contexto consumidor." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="952" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v180" value="Desde aqui el flujo es identico al del bloque COMMAND: finders, validator, rules, mapper y OutputPort." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1184" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v181" value="El ACK va &lt;b&gt;despues&lt;/b&gt; de que el handler termino sin excepcion. Si lanza, basicNack(requeue = false) manda el mensaje a la DLQ en vez de reencolarlo en bucle." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1416" y="4747" width="206" height="140" as="geometry"/></mxCell>
        <mxCell id="v182" value="LEYENDA" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="4917" width="3918" height="22" as="geometry"/></mxCell>
        <mxCell id="v183" value="&lt;b&gt;Notacion&lt;/b&gt;&lt;br&gt;Flecha continua = llamada sincrona (numerada en orden de ejecucion).&lt;br&gt;Flecha discontinua = retorno.&lt;br&gt;Flecha en bucle sobre la propia linea = trabajo interno del objeto.&lt;br&gt;Barra vertical = activacion, del primer al ultimo mensaje del objeto." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="24" y="4943" width="966" height="82" as="geometry"/></mxCell>
        <mxCell id="v184" value="&lt;b&gt;domain&lt;/b&gt;&lt;br&gt;Java puro: sin Spring, sin Lombok, sin JPA, sin Javadoc.&lt;br&gt;Agregados ({Entidad}Domain), objetos de accion, value objects de model/, reglas de rules/impl/, eventos de event/ y excepciones de exception/ &amp;#8212; todo por feature.&lt;br&gt;&lt;b&gt;No declara puertos ni hace I/O de ningun tipo.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1008" y="4943" width="966" height="82" as="geometry"/></mxCell>
        <mxCell id="v185" value="&lt;b&gt;application&lt;/b&gt;&lt;br&gt;Interactor (transaccion), UseCase (orquestacion e I/O), Finder, Validator, Command / Criteria (entrada), Result / ReadModel (salida), Entity y sus puertos.&lt;br&gt;Depende de domain y de los shared, nunca de infrastructure ni de JPA." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1992" y="4943" width="966" height="82" as="geometry"/></mxCell>
        <mxCell id="v186" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;Adaptadores primarios (Controller HTTP, Consumer AMQP) y secundarios (OutputAdapter sobre JPA, Keycloak, Redis, MinIO), JpaEntity, JpaQueryEntity, repositorios Spring Data, config y filtros.&lt;br&gt;Depende de application; &lt;b&gt;jamas ve la capa de dominio&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2976" y="4943" width="966" height="82" as="geometry"/></mxCell>
        <mxCell id="v187" value="&lt;b&gt;Mapper estatico&lt;/b&gt; (morado): clase final con constructor privado y metodos static &amp;#8212; &lt;b&gt;no es un bean&lt;/b&gt;, por eso no aparece como dependencia inyectada. Hay uno por frontera: RequestMapper (DTO&amp;#8594;Command, infrastructure), {Accion}{Entidad}Mapper (Command&amp;#8594;Domain, application/primaryport), {Entidad}Mapper (Entity&amp;#8596;Domain, application/secondaryport), {Entidad}JpaMapper (Entity&amp;#8596;JpaEntity, infrastructure), {Entidad}QueryMapper (JpaQueryEntity&amp;#8594;ReadModel, infrastructure) y {Entidad}ResponseMapper (ReadModel&amp;#8594;ResponseDTO, infrastructure).&lt;br&gt;&lt;b&gt;Excepciones y codigos HTTP:&lt;/b&gt; DomainException y DomainValidationException &amp;#8594; 422 &amp;#183; ApplicationException (incluida FiltroException) &amp;#8594; 400 &amp;#183; InfrastructureException &amp;#8594; 503. Las resuelve GlobalAppExceptionHandler (shared:web) recorriendo la cadena de superclases; los contextos no definen su propio handler.&lt;br&gt;&lt;b&gt;Contextos con implementacion real:&lt;/b&gt; seguridad, usuarios, fichas y notificaciones. El diagrama usa fichas como ejemplo por ser el mas completo; seguridad no lleva @Transactional en sus interactors porque no tiene DataSource propio (Keycloak + Redis)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="24" y="5049" width="3918" height="67" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
