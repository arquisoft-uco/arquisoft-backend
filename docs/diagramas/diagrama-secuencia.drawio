        <mxCell id="n_ctrl" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" value="{Accion}XxxControlador @RestController + @PreAuthorize. Invoca el RequestMapper y luego el Interactor (nunca el UseCase). No referencia dominio." vertex="1">
          <mxGeometry height="160" width="180" x="150" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="n_reqmap" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#f8e6ff;strokeColor=#9673a6;" value="{Accion}XxxRequestMapper Clase estatica (infra/web/mapper). toCommand(dto): XxxCommand. No es @Component: no aparece como dependencia inyectada." vertex="1">
          <mxGeometry height="160" width="170" x="370" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="n_inter" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="{Accion}XxxInteractor Entry point real del command. Dueno de la transaccion: @Transactional(transactionManager =&quot;xxxTransactionManager&quot;). Puede orquestar varios UseCase." vertex="1">
          <mxGeometry height="160" width="180" x="580" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="n_appmap" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#f8e6ff;strokeColor=#9673a6;" value="{Accion}XxxMapper Clase estatica (application/ command/mapper). toDomain (command): XxxDomain — delega la validacion a XxxDomain.crear()." vertex="1">
          <mxGeometry height="160" width="170" x="800" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="n_dom" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="XxxDomain Aggregate root. Sin constructor publico, setters privados (Notification Pattern). crear() valida invariantes; reconstruir() rearma desde BD. Sin Lombok/Spring." vertex="1">
          <mxGeometry height="160" width="150" x="1010" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="n_uc" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="{Accion}XxxUseCase @Component (nunca @Service). NO implementa Interactor — dos beans del mismo puerto rompen la inyeccion. Orquesta dominio via XxxOutputPort (DIP)." vertex="1">
          <mxGeometry height="160" width="180" x="1200" y="1066" as="geometry" />
        </mxCell>
        <mxCell id="n_out" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" value="XxxOutputAdapter Implementa XxxOutputPort (domain/port/out). DIP. Delega el mapeo Domain&lt;-&gt;Entity al Mapper de persistencia; nunca lo hace inline. Suffix OutputAdapter." vertex="1">
          <mxGeometry height="160" width="190" x="1420" y="1066" as="geometry" />
        </mxCell>
