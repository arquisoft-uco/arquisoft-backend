        <mxCell id="e62" value="27: validar(new Existencia{Concepto}&lt;br&gt;(id, existe))" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2453" y="1521" as="sourcePoint"/><mxPoint x="2673" y="1521" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e63" value="void &amp;#124; throw DomainException &amp;#8594; 422" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2673" y="1558" as="sourcePoint"/><mxPoint x="2453" y="1558" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e64" value="void" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2441" y="1595" as="sourcePoint"/><mxPoint x="1989" y="1595" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e65" value="30: toEntity(dominio)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1989" y="1632" as="sourcePoint"/><mxPoint x="2905" y="1632" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e66" value="{Entidad}Entity" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2905" y="1669" as="sourcePoint"/><mxPoint x="1989" y="1669" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e67" value="32: registrar{Entidad}(entity)&lt;br&gt;&amp;#171;{Entidad}OutputPort&amp;#187;" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontStyle=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1989" y="1721" as="sourcePoint"/><mxPoint x="3137" y="1721" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e68" value="33: toJpaEntity(entity)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3149" y="1758" as="sourcePoint"/><mxPoint x="3369" y="1758" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e69" value="{Entidad}JpaEntity" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3369" y="1795" as="sourcePoint"/><mxPoint x="3149" y="1795" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e70" value="35: save(jpaEntity)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3149" y="1832" as="sourcePoint"/><mxPoint x="3601" y="1832" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e71" value="(ok)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3601" y="1869" as="sourcePoint"/><mxPoint x="3149" y="1869" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e72" value="void" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3137" y="1906" as="sourcePoint"/><mxPoint x="1989" y="1906" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e73" value="38: publish(new {Concepto}Event(...))" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1989" y="1943" as="sourcePoint"/><mxPoint x="3833" y="1943" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e74" value="39: ApplicationEventPublisher &amp;#8594;&lt;br&gt;INSERT event_publication&lt;br&gt;(misma transaccion: outbox)" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3907" y="2012"/><mxPoint x="3907" y="2030"/></Array><mxPoint x="3845" y="2012" as="sourcePoint"/><mxPoint x="3845" y="2030" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e75" value="void" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3833" y="2067" as="sourcePoint"/><mxPoint x="1989" y="2067" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e76" value="UUID / void" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1977" y="2104" as="sourcePoint"/><mxPoint x="1061" y="2104" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e77" value="UUID / void &amp;#8212; commit;&lt;br&gt;Modulith externaliza a RabbitMQ" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;fontStyle=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1049" y="2156" as="sourcePoint"/><mxPoint x="365" y="2156" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e78" value="HTTP 201 + {Accion}{Entidad}ResponseDTO" style="html=1;verticalAlign=bottom;align=center;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="353" y="2193" as="sourcePoint"/><mxPoint x="133" y="2193" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v79" value="Un controller por accion (@RestController + @PreAuthorize). Inyecta el &lt;b&gt;Interactor&lt;/b&gt;, nunca el UseCase. Sin literales: ApiCodes, FichasApiKeys, FichasAuthorities, FichasRoutes." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="256" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v80" value="Convencion de contexto grande (fichas): el DTO es un record sin anotaciones Jakarta y este mapper estatico hace toCommand(dto). En contextos pequenos (seguridad, usuarios) no existe: el DTO expone su propio toCommand()." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="488" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v81" value="record con factory crear(...): aqui vive la validacion de &lt;b&gt;integridad&lt;/b&gt; acumulable (Notification Pattern). El formato de un identificador se valida con ValidatorUUID, &lt;b&gt;nunca&lt;/b&gt; con una anotacion Jakarta." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v82" value="Entry point real del comando y dueno de la transaccion: @Transactional(transactionManager = &quot;{contexto}TransactionManager&quot;). seguridad es la excepcion: sin DataSource propio, sin anotacion." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="952" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v83" value="Convierte Command &amp;#8594; dominio. Solo existe cuando la accion no mapea al agregado raiz sino a un &lt;b&gt;objeto de accion&lt;/b&gt;; delega la validacion a los crear(...) de dominio." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1184" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v84" value="Agregado raiz (sufijo Domain, sustantivo). Sin constructor publico, campos no-final con setters privados, solo getters. crear(...) valida invariantes; reconstruir(...) rearma desde BD. Constante VACIO + esVacio(). Sin Lombok ni Spring." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1416" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v85" value="Objeto de dominio de la &lt;b&gt;accion&lt;/b&gt;, nombrado por nominalizacion del verbo: Registro/Modificacion/Cambio/Agregacion/Remocion. Agrupa el agregado con lo que esa accion arrastra. Vive junto al agregado, sin subcarpeta." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1648" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v86" value="@Component (nunca @Service). &lt;b&gt;Todo el I/O del comando vive aqui&lt;/b&gt;: llama a los Finder, al Validator, mapea a Entity y persiste. No implementa el Interactor: dos beans del mismo puerto rompen la inyeccion." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1880" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v87" value="Una consulta = un Finder (extiende shared.rules.Finder&amp;lt;T,R&amp;gt;). &lt;b&gt;Siempre devuelve valor, nunca lanza por &quot;no encontrado&quot;&lt;/b&gt;: Boolean, Long u Optional. Delega en el OutputPort y mapea Entity &amp;#8594; Domain." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2112" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v88" value="Interfaz + impl (@Component). &lt;b&gt;Puro&lt;/b&gt;: solo inyecta Rule de dominio, jamas un OutputPort ni un Finder. Recibe el dato ya consultado y orquesta las Rule en orden. &lt;b&gt;No contiene un solo if&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2344" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v89" value="Interfaz {Regla}Rule (extiende DomainRule&amp;lt;T&amp;gt;) + impl POJO &lt;b&gt;sin dependencias de constructor&lt;/b&gt;. validar(T) es una decision pura sobre un record de domain/{feature}/model/: no consulta nada, solo lanza. Se registran en {Contexto}DomainRulesConfig." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2576" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v90" value="Mapper estatico Entity &amp;#8617;&amp;#8594; Domain. El &lt;b&gt;UseCase&lt;/b&gt; lo usa para toEntity antes del puerto; el &lt;b&gt;Finder&lt;/b&gt; para toDomain despues. Convierte los enum de catalogo con {Enum}.desde(texto), nunca valueOf." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2808" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v91" value="Implementa el OutputPort de application. El puerto habla &lt;b&gt;Entity, nunca Domain&lt;/b&gt;: infrastructure no ve la capa de dominio. Aqui —y solo aqui— ocurre Entity &amp;#8596; JpaEntity." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="3040" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v92" value="Mapper estatico Entity &amp;#8596; JpaEntity. Una asociacion @ManyToOne se arma con {Otro}JpaMapper.toReferencia(id): instancia desligada solo con el id, sin cascade, asi Hibernate escribe unicamente la clave foranea." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="3272" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v93" value="Interfaz Spring Data que extiende JpaRepository (lado escritura). El {Entidad}JpaEntity con @Entity/@Table/Lombok vive en secondaryadapter/entity/ — es la unica JPA real del feature." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="3504" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v94" value="publish() solo hace ApplicationEventPublisher.publishEvent: Spring Modulith inserta en event_publication dentro de la &lt;b&gt;misma transaccion&lt;/b&gt; (outbox). Al hacer commit se externaliza al exchange de RabbitMQ con routing key = temaEvento." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="3736" y="2249" width="206" height="155" as="geometry"/></mxCell>
        <mxCell id="v95" value="BLOQUE 2 &amp;#8212; QUERY (lectura)&lt;br&gt;&lt;font style=&#x27;font-size:11px;font-weight:normal&#x27;&gt;Controller &amp;#8594; RequestMapper &amp;#8594; Criteria &amp;#8594; UseCase (@Transactional readOnly, &lt;b&gt;sin Interactor&lt;/b&gt;) &amp;#8594; QueryOutputAdapter &amp;#8594; PageableMapper / JpaSpecification &amp;#8594; QueryRepository sobre JpaQueryEntity (@Subselect) &amp;#8594; QueryMapper &amp;#8594; ResponseMapper&lt;br&gt;el lado query no comparte ni una clase de persistencia con el lado command&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="2460" width="2526" height="71" as="geometry"/></mxCell>
        <mxCell id="v96" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&amp;#171;UI / externo&amp;#187;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;size=119;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="24" y="2549" width="206" height="1211" as="geometry"/></mxCell>
        <mxCell id="v97" value="&lt;b&gt;:{Consultar}{Entidad}Controller&lt;/b&gt;&lt;br&gt;&amp;#171;query/primaryadapter/web &amp;#183; infrastructure&amp;#187;&lt;br&gt;&lt;i&gt;ej. ConsultarFichasPerfilController&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;size=119;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="256" y="2549" width="206" height="1211" as="geometry"/></mxCell>
        <mxCell id="v98" value="&lt;b&gt;:{Consultar}{Entidad}RequestMapper&lt;/b&gt;&lt;br&gt;&amp;#171;final, estatico &amp;#183; query/web/mapper&amp;#187;&lt;br&gt;&lt;i&gt;ej. ConsultarFichasPerfilRequestMapper&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=119;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="2549" width="206" height="1211" as="geometry"/></mxCell>
        <mxCell id="v99" value="&lt;b&gt;:{Entidad}ResponseMapper&lt;/b&gt;&lt;br&gt;&amp;#171;final, estatico &amp;#183; query/web/mapper&amp;#187;&lt;br&gt;&lt;i&gt;ej. FichaPerfilResponseMapper&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=119;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="720" y="2549" width="206" height="1211" as="geometry"/></mxCell>
        <mxCell id="v100" value="&lt;b&gt;:{Entidad}Criteria&lt;/b&gt;&lt;br&gt;&amp;#171;QueryCriteria.BaseBuilder &amp;#183; query/criteria&amp;#187;&lt;br&gt;&lt;i&gt;ej. FichaPerfilCriteria&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;size=119;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="952" y="2549" width="206" height="1211" as="geometry"/></mxCell>
        <mxCell id="v101" value="&lt;b&gt;:{Consultar}{Entidad}UseCaseImpl&lt;/b&gt;&lt;br&gt;&amp;#171;@Transactional(readOnly) &amp;#183; query/primaryport&amp;#187;&lt;br&gt;&lt;i&gt;ej. ConsultarFichasPerfilUseCaseImpl&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;size=119;fontSize=11;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="1184" y="2549" width="206" height="1211" as="geometry"/></mxCell>
